PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lovable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Clerk (backend)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_PUBLISHABLE_KEY=

# OpenAI (for AI chat in project editor)
OPENAI_API_KEY=

# AWS S3 (for logo uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=lovable-logos

# Resend (for transactional emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lovable <onboarding@resend.dev>

# App URL (for email links, redirects)
APP_URL=https://lovable.dev

# Stripe (Pro plan payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Solana airdrop relayer (optional – for "one confirmation, then auto-batches")
# Secret key as: base58 (Phantom "Export Private Key"), base64, or JSON array. Relayer pays tx fees and ATA rent.
SOLANA_RELAYER_SECRET_KEY=4Hei7WNgQPrjQrJirzWHnKrFLm7j6DYpBhcjNc1o3S6MtReB4wvNiSYuvPfBaD7rFj4eB8mW7qqWg2Pt6ZVw5fW9
# RPC URLs for Send all (relayer). If unset, public RPC is used and you will hit 429. Prefer Helius or another provider.
# Helius devnet: https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_DEVNET_RPC_URL=
# Helius mainnet: https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_MAINNET_RPC_URL=
# Optional: single RPC used for both (fallback if DEVNET/MAINNET not set)
# SOLANA_RPC_URL=
# Optional: delay in ms between each batch (for rate limits, e.g. Helius free 1 tx/sec). Default 6000.
# Delay (ms) between each batch. Helius free: 1 sendTransaction/sec, 10 req/sec – default 6000. Increase to 8000 if you still hit 429.
# SOLANA_RELAYER_DELAY_MS=6000
# Delay (ms) between RPC calls within a batch (getMultipleAccountsInfo, getLatestBlockhash, send). Default 1000.
# SOLANA_RELAYER_BETWEEN_RPC_MS=1000

# Optional: Etherscan API key (V2) for airdrop participation checks (min transactions, min gas spent) on all supported EVM chains.
# ETHERSCAN_API_KEY=   If unset, calls use strict rate limits.

# Partner create flow — one secret per affiliate partner (must match payload.partner).
# Example: payload { "partner": "coinsniper", ... } → COINSNIPER_SECRET_KEY
COINSNIPER_SECRET_KEY=
# DEXSCREENER_SECRET_KEY=