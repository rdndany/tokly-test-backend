PORT=8000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lovable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Clerk (backend)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_PUBLISHABLE_KEY=

# OpenAI (for AI chat in project editor)
OPENAI_API_KEY=

# AWS S3 (for logo uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_S3_BUCKET_NAME=lovable-logos

# Resend (for transactional emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lovable <onboarding@resend.dev>

# App URL (for email links, e.g. project URLs)
APP_URL=https://lovable.dev
